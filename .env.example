# Browser-safe auth configuration
# Supported values: clerk, supabase, or mock (mock is for local/preview use only).
NEXT_PUBLIC_AUTH_PROVIDER=clerk
NEXT_PUBLIC_USE_MOCK_AUTH=false

# Clerk browser configuration
NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=
NEXT_PUBLIC_CLERK_SIGN_IN_URL=/login
NEXT_PUBLIC_CLERK_SIGN_UP_URL=/sign-up
NEXT_PUBLIC_CLERK_SIGN_IN_FALLBACK_REDIRECT_URL=/upsc
NEXT_PUBLIC_CLERK_SIGN_UP_FALLBACK_REDIRECT_URL=/upsc

# Supabase browser configuration (used only when NEXT_PUBLIC_AUTH_PROVIDER=supabase)
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Retired Firebase compatibility keys. The active frontend provider boundary does not read these.
NEXT_PUBLIC_FIREBASE_API_KEY=
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=
NEXT_PUBLIC_FIREBASE_PROJECT_ID=
NEXT_PUBLIC_FIREBASE_STORAGE_BUCKET=
NEXT_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=
NEXT_PUBLIC_FIREBASE_APP_ID=

# Backend API configuration
NEXT_PUBLIC_API_BASE_URL=http://localhost:8000/api/v1
NEXT_PUBLIC_API_URL=http://localhost:8000/api/v1

# Public-safe Geography Day 1 release assets. Keep approval false until the founder recording is selected.
NEXT_PUBLIC_UPSC_GEOGRAPHY_DAY1_MEDIA_APPROVED=false
NEXT_PUBLIC_UPSC_GEOGRAPHY_DAY1_MEDIA_URL=
NEXT_PUBLIC_UPSC_GEOGRAPHY_DAY1_MEDIA_LABEL=
NEXT_PUBLIC_UPSC_GEOGRAPHY_DAY1_TRANSCRIPT_URL=

# Server-only production configuration
CLERK_SECRET_KEY=
SUPABASE_SECRET_KEY=
NVIDIA_API_BASE_URL=https://integrate.api.nvidia.com/v1
NVIDIA_TEACHER_API_KEY=
NVIDIA_TEACHER_MODEL=z-ai/glm-5.1
NVIDIA_CHAT_API_KEY=
NVIDIA_CHAT_MODEL=deepseek-ai/deepseek-v4-flash
NVIDIA_CONTENT_API_KEY=
NVIDIA_CONTENT_MODEL=nvidia/nemotron-3-ultra-550b-a55b
NVIDIA_STT_API_BASE_URL=https://integrate.api.nvidia.com/v1
NVIDIA_STT_API_KEY=
NVIDIA_STT_MODEL=
UPSC_STT_MAX_AUDIO_BYTES=8000000

# Keep retired backend surfaces isolated unless they are intentionally restored
NEXT_PUBLIC_ENABLE_LEGACY_API=false
