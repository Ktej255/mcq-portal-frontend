# Backend (FastAPI) environment. Copy to `.env` for local work; in production
# set these in the backend's Vercel project (Settings > Environment Variables).
# Never commit real values.

APP_ENVIRONMENT=production

# --- Database: Supabase Postgres -------------------------------------------
# Supabase dashboard > Connect > "Transaction pooler" connection string
# (port 6543). The app already uses NullPool, which suits the pooler and
# serverless functions. Add ?sslmode=require.
DATABASE_URL=postgresql://postgres.<project-ref>:<password>@aws-0-<region>.pooler.supabase.com:6543/postgres?sslmode=require

# --- Answer-sheet images: Supabase Storage (S3 protocol) -------------------
# Serverless disks are temporary, so production must not use the local store.
MEDIA_STORE_BACKEND=s3
MEDIA_STORE_S3_BUCKET=answer-images
MEDIA_STORE_S3_ENDPOINT_URL=https://<project-ref>.storage.supabase.co/storage/v1/s3
MEDIA_STORE_S3_REGION=<project-region>
MEDIA_STORE_S3_ACCESS_KEY_ID=
MEDIA_STORE_S3_SECRET_ACCESS_KEY=

# --- Auth (Clerk) ------------------------------------------------------------
CLERK_JWKS_URL=
CLERK_JWT_KEY=

# --- CORS: frontend origins, comma separated -------------------------------
BACKEND_CORS_ORIGINS=https://saritclasses.com,https://www.saritclasses.com,https://app.saritclasses.com

# --- GS LMS paid-beta guardrails (production refuses to start without these)
GS_LMS_ENFORCE_ACCESS=true
GS_LMS_BETA_SCOPE=true

# --- Paywall -----------------------------------------------------------------
PAYWALL_ENABLED=false
TRIAL_DAYS=7
# PAYWALL_LAUNCH_DATE=2026-12-01

# --- AI providers --------------------------------------------------------------
# One key for every Gemini feature (the web app reads the same name).
GEMINI_API_KEY=
# Optional. Defaults to a current stable model; change it when Google retires one.
GEMINI_MODEL=
AI_REQUEST_TIMEOUT_SECONDS=30

# --- Payments (Cashfree) -------------------------------------------------------
CASHFREE_APP_ID=
CASHFREE_SECRET_KEY=
CASHFREE_ENVIRONMENT=production

# --- Email / WhatsApp ----------------------------------------------------------
RESEND_API_KEY=
EMAIL_FROM_ADDRESS=
WATI_API_URL=
WATI_API_KEY=

# Local development only. Must stay false in production.
ALLOW_MOCK_AUTH=false
