{
  "family": "mcq-portal-task",
  "networkMode": "awsvpc",
  "requiresCompatibilities": [
    "FARGATE"
  ],
  "cpu": "256",
  "memory": "512",
  "executionRoleArn": "arn:aws:iam::<ACCOUNT_ID>:role/<ECS_EXECUTION_ROLE>",
  "taskRoleArn": "arn:aws:iam::<ACCOUNT_ID>:role/<ECS_TASK_ROLE>",
  "containerDefinitions": [
    {
      "name": "mcq-portal-backend",
      "image": "<ACCOUNT_ID>.dkr.ecr.ap-south-1.amazonaws.com/mcq-portal-backend:latest",
      "essential": true,
      "portMappings": [
        {
          "containerPort": 8080,
          "hostPort": 8080
        }
      ],
      "environment": [
        {
          "name": "ALLOW_MOCK_AUTH",
          "value": "false"
        },
        {
          "name": "CASHFREE_ENVIRONMENT",
          "value": "production"
        },
        {
          "name": "BACKEND_CORS_ORIGINS",
          "value": "https://upsc-command.vercel.app"
        },
        {
          "name": "PAYWALL_ENABLED",
          "value": "false"
        },
        {
          "name": "TRIAL_DAYS",
          "value": "7"
        },
        {
          "name": "ALLOW_MOCK_AI",
          "value": "false"
        },
        {
          "name": "OPTIONAL_OCR_PROVIDER",
          "value": "gemini-vision"
        },
        {
          "name": "EVALUATION_PROVIDER",
          "value": "gemini"
        },
        {
          "name": "OPTIONAL_EVAL_PROVIDER",
          "value": "gemini"
        },
        {
          "name": "GEMINI_MODEL_ID",
          "value": "gemini-2.5-flash"
        },
        {
          "name": "ANSWER_IMAGE_RETENTION_DAYS",
          "value": "180"
        },
        {
          "name": "MEDIA_STORE_BACKEND",
          "value": "s3"
        },
        {
          "name": "MEDIA_STORE_S3_BUCKET",
          "value": "<ANSWER_IMAGE_BUCKET>"
        },
        {
          "name": "AWS_REGION",
          "value": "ap-south-1"
        }
      ],
      "secrets": [
        {
          "name": "DATABASE_URL",
          "valueFrom": "arn:aws:secretsmanager:ap-south-1:<ACCOUNT_ID>:secret:mcq-portal/DATABASE_URL"
        },
        {
          "name": "GOOGLE_API_KEY",
          "valueFrom": "arn:aws:secretsmanager:ap-south-1:<ACCOUNT_ID>:secret:mcq-portal/GOOGLE_API_KEY"
        },
        {
          "name": "CLERK_JWT_KEY",
          "valueFrom": "arn:aws:secretsmanager:ap-south-1:<ACCOUNT_ID>:secret:mcq-portal/CLERK_JWT_KEY"
        },
        {
          "name": "CASHFREE_APP_ID",
          "valueFrom": "arn:aws:secretsmanager:ap-south-1:<ACCOUNT_ID>:secret:mcq-portal/CASHFREE_APP_ID"
        },
        {
          "name": "CASHFREE_SECRET_KEY",
          "valueFrom": "arn:aws:secretsmanager:ap-south-1:<ACCOUNT_ID>:secret:mcq-portal/CASHFREE_SECRET_KEY"
        }
      ],
      "logConfiguration": {
        "logDriver": "awslogs",
        "options": {
          "awslogs-group": "/aws/ecs/mcq-portal-backend",
          "awslogs-region": "ap-south-1",
          "awslogs-stream-prefix": "ecs",
          "awslogs-create-group": "true"
        }
      }
    }
  ]
}
