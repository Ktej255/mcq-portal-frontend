# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage
/validation-artifacts/
scratch/*.log
scratch/*.png
scratch/*.json

# next.js
/.next/
/.next-*/
/out/

# production
/build

# misc
.DS_Store
*.pem

# debug
/*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files (can opt-in for committing if needed)
.env*
!.env.example

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts

.vercel

# Backend secrets and local databases never go in git
/backend/task-definition.json
/backend/**/*.db
/backend/.hypothesis/

# Local browser profiles (hold cookies and saved logins) — never commit
/.playwright*/

# Playwright output
/test-results/
/playwright-report/

# Converted EduEcosystem question banks (book-derived; regenerate with
# backend/scripts/eduecosystem_import/convert.py). Kept out of git while the repo is public.
backend/app/core/gs_lms/data/retention/*.json

# Bank-derived and team-working files for the content tools. They may hold
# book-derived questions, so they never go in git. Written here by default:
#   bank_matcher (matches CSV, supplements) and sheets (CSV template folders)
backend/app/core/gs_lms/data/supplements/
backend/app/core/gs_lms/data/bank_matches/
backend/app/core/gs_lms/data/sheets/
